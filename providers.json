    {
      "id": "liriqo",
      "name": "LiriQo",
      "category": "lyrics",
      "enabled": true,
      "adapter": "liriqo",
      "base_urls": [
        "https://liriqo-alfarrizi.my.id"
      ],
      "capabilities": [
        "plain_lyrics",
        "synced_lyrics",
        "lrc",
        "word_synced_lyrics"
