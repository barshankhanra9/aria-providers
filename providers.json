      "priority": 5
    },
    {
      "id": "musixmatch",
      "name": "Musixmatch",
      "category": "lyrics",
      "enabled": true,
      "adapter": "musixmatch",
      "base_urls": [
        "https://musixmatch.com"
      ],
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
        "Cookie": "x-mxm-token-guid="
      },
      "params": {
        "app_id": "web-desktop-app-v1.0",
        "format": "json"
      },
      "capabilities": [
        "plain_lyrics",
        "synced_lyrics",
        "lrc"
