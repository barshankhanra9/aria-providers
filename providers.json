{
  "schema_version": 2,
  "config_version": "1.0.0",
  "updated_at": "2026-11-23",
  "description": "ARIA centralized provider registry. Provider URLs and capabilities are configurable; provider-specific adapters remain in the app.",
  "providers": [
    {
      "id": "jiosaavn",
      "name": "JioSaavn",
      "category": "music",
      "enabled": true,
      "adapter": "jiosaavn",
      "base_urls": [
        "https://saavn.dev/api"
      ],
      "capabilities": [
        "search",
        "track_details",
        "album",
        "artist",
        "playlist",
        "stream_resolver"
      ],
      "priority": 10
    },
    {
      "id": "piped",
      "name": "Piped",
      "category": "music",
      "enabled": true,
      "adapter": "piped",
      "base_urls": [
        "https://pipedapi.kavin.rocks",
        "https://pipedapi.adminforge.de",
        "https://pipedapi.leptons.xyz",
        "https://api.piped.private.coffee",
        "https://pipedapi.nosebs.ru"
      ],
      "capabilities": [
        "search",
        "track_details",
        "stream_resolver"
      ],
      "priority": 20
    },
    {
      "id": "invidious",
      "name": "Invidious",
      "category": "music",
      "enabled": true,
      "adapter": "invidious",
      "base_urls": [
        "https://inv.nadeko.net",
        "https://invidious.nerdvpn.de",
        "https://yt.chocolatemoo53.com",
        "https://invidious.tiekoetter.com"
      ],
      "capabilities": [
        "search",
        "track_details",
        "stream_resolver"
      ],
      "priority": 30
    },
    {
      "id": "lrclib",
      "name": "LRCLIB",
      "category": "lyrics",
      "enabled": true,
      "adapter": "lrclib",
      "base_urls": [
        "https://lrclib.net"
      ],
      "capabilities": [
        "plain_lyrics",
        "synced_lyrics",
        "lrc"
      ],
      "priority": 10
    }
  ],
  "provider_defaults": {
    "endpoint_failover": true,
    "max_retries_per_endpoint": 1,
    "request_timeout_ms": 10000,
    "health_check_cooldown_ms": 300000
  }
}
