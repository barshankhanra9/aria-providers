      "priority": 15
    },
    {
      "id": "lrclib",
      "name": "LRCLIB",
      "category": "lyrics",
      "enabled": true,
      "adapter": "lrclib",
      "base_urls": [
        "https://lrclib.net"
      ],
      "capabilities": [
        "plain_lyrics",
        "synced_lyrics",
        "lrc"
      ],
      "priority": 20
    }
  ],
  "metadata_cleaning": {
    "strip_brackets_regex": "\\(.*?\\)|\\[.*?]",
    "strip_keywords_regex": "(?i)\\b(official|video|audio|lyrical|lyrics|full song|music video|4k|hd|remix|slowed|reverb)\\b",
    "title_delimiters": ["|", "-", "//"]
  },
  "provider_defaults": {
    "endpoint_failover": true,
    "max_retries_per_endpoint": 1,
    "request_timeout_ms": 4500,
    "health_check_cooldown_ms": 300000
  }
}
