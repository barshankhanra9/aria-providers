        "track_details",
        "stream_resolver"
      ],
      "priority": 20
    },
    {
      "id": "invidious",
      "name": "Invidious",
      "category": "music",
      "enabled": true,
      "adapter": "invidious",
      "base_urls": [
        "https://nadeko.net",
        "https://nerdvpn.de",
        "https://chocolatemoo53.com",
