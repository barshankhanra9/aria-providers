        "https://saavn.bycomsolutions.com/api"
      ],
      "capabilities": [
        "search",
        "track_details",
        "album",
        "artist",
        "playlist",
        "stream_resolver",
        "lyrics"
      ],
      "priority": 10
    },
    {
      "id": "piped",
      "name": "Piped",
